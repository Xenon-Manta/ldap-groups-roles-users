{
  "_comment": "POSIX filesystem and access control rules for Saffell-Soft. Consumed by rbac_fs.py and rbac_sync.py. Do not edit manually without re-running both scripts.",

  "base_dir": "/srv/saffell-soft",

  "parent_dirs": [
    {
      "path": "employee",
      "owner": "root",
      "group": "root",
      "mode": "755",
      "_comment": "World-traversable so Board can reach employee subfolders where ACLs grant r-x."
    },
    {
      "path": "manager",
      "owner": "root",
      "group": "Manager",
      "mode": "750",
      "_comment": "Only Manager group and root can traverse. Board gets r-x via ACL entry. Employee is blocked as others."
    },
    {
      "path": "board",
      "owner": "root",
      "group": "Board",
      "mode": "750",
      "_comment": "Only Board group and root can traverse. Employee and Manager have no access."
    }
  ],

  "folders": [
    {
      "path": "employee/shared",
      "owner": "root",
      "group": "Employee",
      "mode": "2770",
      "_comment": "setgid + rwxrws--- — Employee full rw; others none. ACLs grant Manager rw and Board r."
    },
    {
      "path": "employee/projects",
      "owner": "root",
      "group": "Employee",
      "mode": "2770",
      "_comment": "setgid + rwxrws--- — Employee full rw; others none. ACLs grant Manager rw and Board r."
    },
    {
      "path": "manager/shared",
      "owner": "root",
      "group": "Manager",
      "mode": "2770",
      "_comment": "setgid + rwxrws--- — Manager full rw; others none. ACL grants Board r."
    },
    {
      "path": "manager/reports",
      "owner": "root",
      "group": "Manager",
      "mode": "2770",
      "_comment": "setgid + rwxrws--- — Manager full rw; others none. ACL grants Board r."
    },
    {
      "path": "board/workspace",
      "owner": "root",
      "group": "Board",
      "mode": "2770",
      "_comment": "setgid + rwxrws--- — Board full rw via group membership. Employee/Manager have no access."
    }
  ],

  "acls": [
    {
      "path": "employee",
      "entry": "group:deny_employee:---",
      "_comment": "Audit marker — named-user deny entries for deny_employee members are applied by rbac_sync.py."
    },

    {
      "path": "employee/shared",
      "entry": "group:Employee:rwx"
    },
    {
      "path": "employee/shared",
      "entry": "default:group:Employee:rwx",
      "_comment": "New files inherit Employee group-write."
    },
    {
      "path": "employee/shared",
      "entry": "default:mask::rwx",
      "_comment": "Prevent ACL mask from stripping group-write on inherited entries."
    },
    {
      "path": "employee/projects",
      "entry": "group:Employee:rwx"
    },
    {
      "path": "employee/projects",
      "entry": "default:group:Employee:rwx"
    },
    {
      "path": "employee/projects",
      "entry": "default:mask::rwx"
    },

    {
      "path": "employee/shared",
      "entry": "group:Manager:rwx",
      "_comment": "Manager read+write on employee folders."
    },
    {
      "path": "employee/shared",
      "entry": "default:group:Manager:rwx"
    },
    {
      "path": "employee/projects",
      "entry": "group:Manager:rwx"
    },
    {
      "path": "employee/projects",
      "entry": "default:group:Manager:rwx"
    },

    {
      "path": "employee/shared",
      "entry": "group:Board:r-x",
      "_comment": "Board read-only on employee folders."
    },
    {
      "path": "employee/shared",
      "entry": "default:group:Board:r-x"
    },
    {
      "path": "employee/projects",
      "entry": "group:Board:r-x"
    },
    {
      "path": "employee/projects",
      "entry": "default:group:Board:r-x"
    },

    {
      "path": "manager",
      "entry": "group:Board:r-x",
      "_comment": "Board needs r-x on manager/ parent to traverse into subfolders."
    },
    {
      "path": "manager",
      "entry": "group:deny_manager:---",
      "_comment": "Audit marker — named-user deny entries for deny_manager members applied by rbac_sync.py."
    },

    {
      "path": "manager/shared",
      "entry": "group:Manager:rwx"
    },
    {
      "path": "manager/shared",
      "entry": "default:group:Manager:rwx"
    },
    {
      "path": "manager/shared",
      "entry": "default:mask::rwx"
    },
    {
      "path": "manager/reports",
      "entry": "group:Manager:rwx"
    },
    {
      "path": "manager/reports",
      "entry": "default:group:Manager:rwx"
    },
    {
      "path": "manager/reports",
      "entry": "default:mask::rwx"
    },

    {
      "path": "manager/shared",
      "entry": "group:Board:r-x",
      "_comment": "Board read-only on manager subfolders."
    },
    {
      "path": "manager/shared",
      "entry": "default:group:Board:r-x"
    },
    {
      "path": "manager/reports",
      "entry": "group:Board:r-x"
    },
    {
      "path": "manager/reports",
      "entry": "default:group:Board:r-x"
    },

    {
      "path": "board/workspace",
      "entry": "group:Board:rwx",
      "_comment": "Board full rw on board/workspace."
    },
    {
      "path": "board/workspace",
      "entry": "default:group:Board:rwx"
    },
    {
      "path": "board/workspace",
      "entry": "default:mask::rwx"
    },

    {
      "path": "manager/shared",
      "entry": "group:Employee:---",
      "_comment": "Belt-and-suspenders deny for Employee on manager subfolders."
    },
    {
      "path": "manager/shared",
      "entry": "default:group:Employee:---"
    },
    {
      "path": "manager/reports",
      "entry": "group:Employee:---"
    },
    {
      "path": "manager/reports",
      "entry": "default:group:Employee:---"
    },
    {
      "path": "board/workspace",
      "entry": "group:Employee:---",
      "_comment": "Belt-and-suspenders deny for Employee on board subfolder."
    },
    {
      "path": "board/workspace",
      "entry": "default:group:Employee:---"
    }
  ],

  "deny_groups": {
    "_comment": "Maps deny group names to the folder paths they block. rbac_sync.py resolves current members of each deny group and applies named-user ACL deny entries (user:<uid>:---) on each path. Named-user entries are used because POSIX group deny ACLs cannot override a positive grant from another group the user belongs to.",
    "deny_employee": [
      "employee",
      "employee/shared",
      "employee/projects"
    ],
    "deny_manager": [
      "manager",
      "manager/shared",
      "manager/reports"
    ],
    "deny_board": [
      "board",
      "board/workspace"
    ]
  },

  "sudo_controls": {
    "_comment": "Sudo access policy. Enforced by rbac_sync.py via OS group membership, not sudoers drop-in files.",
    "privileged_system_groups": ["sudo", "wheel", "admin"],
    "no_sudo_rbac_groups": ["Employee", "Board"],
    "stale_sudoers_files": [
      "00_rbac_deny_employee",
      "00_rbac_deny_board",
      "rbac_fs_employee"
    ]
  }
}
