{
  "ldap_base": "dc=saffell-soft,dc=com",

  "_tier_model": {
    "description": "Tiered permission inheritance. Each tier inherits all permissions of tiers below it.",
    "tiers": {
      "1": { "group": "Employee", "inherits": [] },
      "2": { "group": "Manager",  "inherits": ["Employee"] },
      "3": { "group": "Board",    "inherits": ["Employee", "Manager"] }
    },
    "flat": {
      "3PAO": "No inheritance. Read-only on /var/log and manager/reports only."
    }
  },

  "groups": [
    {
      "name": "Employee",
      "gid": 3001,
      "description": "Tier 1 — standard employees. Read/write on employee folders.",
      "sudo_rules": []
    },
    {
      "name": "Manager",
      "gid": 3002,
      "description": "Tier 2 — inherits Employee. Read/write on employee and manager folders. Full sudo.",
      "sudo_rules": [
        "ALL=(ALL) ALL"
      ]
    },
    {
      "name": "Board",
      "gid": 3003,
      "description": "Tier 3 — inherits Employee and Manager. Read/write own folders, read all others. No sudo.",
      "sudo_rules": []
    },
    {
      "name": "3PAO",
      "gid": 4155,
      "description": "Flat role — Third Party Assessment Organisation. Read-only on /var/log and manager/reports. No inheritance, no sudo.",
      "sudo_rules": []
    },
    {
      "name": "deny_employee",
      "gid": 3901,
      "description": "Deny group — members are blocked from employee folders via named-user ACL entries.",
      "sudo_rules": []
    },
    {
      "name": "deny_manager",
      "gid": 3902,
      "description": "Deny group — members are blocked from manager folders via named-user ACL entries.",
      "sudo_rules": []
    },
    {
      "name": "deny_board",
      "gid": 3903,
      "description": "Deny group — members are blocked from board folders via named-user ACL entries.",
      "sudo_rules": []
    },
    {
      "name": "deny_3PAO",
      "gid": 3904,
      "description": "Deny group — members are blocked from 3PAO read paths (manager/reports, /var/log).",
      "sudo_rules": []
    }
  ],

